# All optional. With NOTHING set, the system runs fully offline:
#   - news comes from data/fixtures/sample-news.json
#   - the "LLM" is a deterministic heuristic (no model needed)
#   - prices are mock/deterministic
# Copy to .env and fill in only what you want to make "real".
#
# NOTE: live news/price sources need outbound network access to their hosts.
# In a locked-down sandbox you must allowlist: stooq.com, finnhub.io,
# www.sec.gov, and whatever RSS hosts you configure.

# --- LLM backend ---
# Options: mock (default) | ollama
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- News source ---
# Options: fixture (default) | rss | edgar | all
NEWS_SOURCE=fixture
# Comma-separated RSS/Atom feed URLs (used when NEWS_SOURCE=rss or all)
NEWS_RSS_FEEDS=https://feeds.a.dj.com/rss/RSSMarketsMain.xml
# SEC EDGAR (used when NEWS_SOURCE=edgar or all). SEC requires a real UA.
EDGAR_USER_AGENT=your-name your-email@example.com
EDGAR_FILING_TYPE=8-K
EDGAR_COUNT=40

# --- Prices ---
# Options: mock (default) | stooq (no key) | finnhub (needs key)
PRICE_PROVIDER=mock
FINNHUB_API_KEY=

# --- Behaviour ---
# Minimum confidence (0..1) required to record a paper trade
MIN_CONFIDENCE=0.4
# Loop interval in seconds (for `npm run loop`)
LOOP_INTERVAL_SECONDS=300
