# All optional. With NOTHING set, the system runs fully offline:
#   - news comes from data/fixtures/sample-news.json
#   - the "LLM" is a deterministic heuristic (no model needed)
#   - prices are mock/deterministic
# Copy to .env and fill in only what you want to make "real".

# --- LLM backend ---
# Options: mock (default) | ollama
LLM_PROVIDER=mock
# Used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- News source ---
# Options: fixture (default) | rss
NEWS_SOURCE=fixture
# Comma-separated RSS feed URLs, used when NEWS_SOURCE=rss
NEWS_RSS_FEEDS=https://feeds.a.dj.com/rss/RSSMarketsMain.xml

# --- Prices ---
# Options: mock (default)
PRICE_PROVIDER=mock

# --- Behaviour ---
# Minimum confidence (0..1) required to record a paper trade
MIN_CONFIDENCE=0.4
# Loop interval in seconds (for `npm run loop`)
LOOP_INTERVAL_SECONDS=300
